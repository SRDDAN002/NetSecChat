  <!-- ========== STYLESHEET: RETRO-FUTURISTIC THEME ========== -->
  <!-- CUSTOMIZABLE: Color Palette (warm neon orange/green) -->
  <property name="styleSheet">
   <string>
/* ===== NEON COLOR PALETTE (CUSTOMIZE HERE) ===== */
QMainWindow {
 background-color: #0A0E27;
 color: #39FF14;
}

QWidget {
 background-color: #0A0E27;
 color: #39FF14;
}

/* ===== CUSTOMIZABLE: Tab Styling ===== */
QTabWidget::pane {
 border: 2px solid #FF6B1A;
 background-color: #0A0E27;
}

QTabBar::tab {
 background-color: #1A1F3A;
 color: #39FF14;
 padding: 8px 20px;
 border: 1px solid #FF6B1A;
 margin-right: 2px;
 font-weight: bold;
 font-family: 'Courier New', monospace;
}

QTabBar::tab:selected {
 background-color: #FF6B1A;
 color: #0A0E27;
 border: 2px solid #39FF14;
}

QTabBar::tab:hover:!selected {
 background-color: #2A2F4A;
 border: 1px solid #39FF14;
}

/* ===== CUSTOMIZABLE: Button Styling (Retro 3D Effect) ===== */
QPushButton {
 background-color: #1A1F3A;
 color: #39FF14;
 border: 2px outset #FF6B1A;
 padding: 6px 12px;
 border-radius: 0px;
 font-weight: bold;
 font-family: 'Courier New', monospace;
 font-size: 10pt;
}

QPushButton:hover {
 background-color: #2A2F4A;
 color: #FF9500;
 border: 2px outset #39FF14;
}

QPushButton:pressed {
 border-style: inset;
 background-color: #0A0E27;
}

/* ===== CUSTOMIZABLE: Input Field Styling (CRT-like) ===== */
QLineEdit, QTextEdit, QPlainTextEdit {
 background-color: #0F1430;
 color: #39FF14;
 border: 1px solid #FF6B1A;
 padding: 4px;
 font-family: 'Courier New', monospace;
 font-size: 10pt;
 selection-background-color: #FF6B1A;
 selection-color: #0A0E27;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
 border: 2px solid #39FF14;
 background-color: #1A1F3A;
}

/* ===== CUSTOMIZABLE: List and Tree View Styling ===== */
QListWidget, QTreeWidget, QTableWidget {
 background-color: #0F1430;
 color: #39FF14;
 border: 1px solid #FF6B1A;
 gridline-color: #FF6B1A;
 font-family: 'Courier New', monospace;
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
 background-color: #FF6B1A;
 color: #0A0E27;
}

QListWidget::item:hover, QTreeWidget::item:hover, QTableWidget::item:hover {
 background-color: #2A2F4A;
 color: #FF9500;
}

/* ===== CUSTOMIZABLE: Scrollbar Styling ===== */
QScrollBar:vertical {
 background-color: #0A0E27;
 width: 16px;
 border: 1px solid #FF6B1A;
}

QScrollBar::handle:vertical {
 background-color: #FF6B1A;
 border-radius: 8px;
 min-height: 20px;
}

QScrollBar::handle:vertical:hover {
 background-color: #39FF14;
}

QScrollBar:horizontal {
 background-color: #0A0E27;
 height: 16px;
 border: 1px solid #FF6B1A;
}

QScrollBar::handle:horizontal {
 background-color: #FF6B1A;
 border-radius: 8px;
 min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
 background-color: #39FF14;
}

/* ===== CUSTOMIZABLE: Label Styling ===== */
QLabel {
 color: #39FF14;
 font-family: 'Courier New', monospace;
}

QLabel[status="active"] {
 color: #39FF14;
}

QLabel[status="inactive"] {
 color: #FF6B1A;
}

/* ===== CUSTOMIZABLE: Menu Bar and Status Bar ===== */
QMenuBar {
 background-color: #1A1F3A;
 color: #39FF14;
 border-bottom: 2px solid #FF6B1A;
}

QMenuBar::item:selected {
 background-color: #FF6B1A;
 color: #0A0E27;
}

QMenu {
 background-color: #1A1F3A;
 color: #39FF14;
 border: 2px solid #FF6B1A;
}

QMenu::item:selected {
 background-color: #FF6B1A;
 color: #0A0E27;
}

QStatusBar {
 background-color: #1A1F3A;
 color: #39FF14;
 border-top: 2px solid #FF6B1A;
}

/* ===== CUSTOMIZABLE: Separator/Divider ===== */
QFrame[frameShape="4"] {
 border-color: #FF6B1A;
}

/* ===== CUSTOMIZABLE: Splitter Styling ===== */
QSplitter::handle {
 background-color: #1A1F3A;
 border-left: 1px solid #FF6B1A;
 border-right: 1px solid #FF6B1A;
}

QSplitter::handle:hover {
 background-color: #2A2F4A;
}
   </string>
